# Base URL of the product API (DummyJSON). Only the server adapter reads it.
NUXT_API_BASE_URL=https://dummyjson.com

# Comma-separated DummyJSON user ids treated as admins, on top of the API's own `role`.
NUXT_ADMIN_USER_IDS=1

# Public URL of the site (canonical URLs, hreflang, sitemap).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret sealing the session cookie (32+ characters). Required in production;
# generated automatically into .env in development.
NUXT_SESSION_PASSWORD=
